# ── Database ──
# PostgreSQL connection string (internal Docker network)
# User: novacal, Database: novacal, Host: novacal-db (Docker service name)
DATABASE_URL=postgresql://novacal:password@novacal-db:5432/novacal

# ── Redis ──
# Redis connection string (internal Docker network)
REDIS_URL=redis://novacal-redis:6379

# ── Auth ──
# Generate with: openssl rand -hex 64
BETTER_AUTH_SECRET=your-secret-here
# Public URL of the web app (used for auth callbacks and cookie domain)
BETTER_AUTH_URL=https://calendar.yourdomain.com

# ── MCP Server ──
# Port for the MCP SSE endpoint (co-located on the realtime server)
MCP_PORT=3001

# ── Real-time Server ──
# WebSocket port (must match docker port mapping)
WS_PORT=3001
# Public WebSocket URL for client connections
WS_URL=wss://ws.yourdomain.com

# ── Network ──
# Set to "true" when running behind Cloudflare Tunnel or other reverse proxy
# Enables trust of X-Forwarded-For and X-Forwarded-Proto headers
TRUST_PROXY=false
# Runtime environment
NODE_ENV=production
