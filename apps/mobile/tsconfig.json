{
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "strict": false,
    "noImplicitAny": false,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": false,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@novacal/shared": ["../../packages/shared"],
      "@novacal/shared/*": ["../../packages/shared/*"],
      "@novacal/db": ["../../packages/db"],
      "@novacal/db/*": ["../../packages/db/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
