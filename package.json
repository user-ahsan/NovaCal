{
  "name": "novacal",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/db",
    "packages/auth",
    "packages/ui",
    "apps/web",
    "apps/realtime",
    "apps/mcp-server"
  ],
  "scripts": {
    "typecheck": "bun run --bun tsc --noEmit",
    "lint": "bun run eslint . --ext .ts,.tsx",
    "dev": "bun run --cwd apps/web dev"
  },
  "dependencies": {
    "typescript": "latest",
    "@types/node": "latest",
    "bun-types": "latest"
  },
  "packageManager": "bun",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react-native": "^0.73.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "expo": "^55.0.23",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.5"
  }
}
