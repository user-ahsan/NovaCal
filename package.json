{
  "name": "novacal",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/db",
    "packages/auth",
    "packages/ui",
    "apps/web",
    "apps/realtime",
    "apps/mcp-server"
  ],
  "scripts": {
    "typecheck": "bun run --bun tsc --noEmit",
    "lint": "bun run eslint . --ext .ts,.tsx",
    "test": "bun run vitest run --reporter verbose",
    "test:watch": "bun run vitest --reporter verbose",
    "dev": "bun run --cwd apps/web dev",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:realtime": "bun run --cwd apps/realtime start",
    "dev:mcp": "bun run --cwd apps/mcp-server start",
    "dev:all": "concurrently \"bun run dev:web\" \"bun run dev:realtime\" \"bun run dev:mcp\"",
    "build": "bun run --cwd apps/web build",
    "start": "bun run --cwd apps/web start",
    "db:generate": "bun run --cwd packages/db generate",
    "db:migrate": "bun run --cwd packages/db migrate",
    "db:push": "bun run --cwd packages/db push",
    "db:studio": "bun run --cwd packages/db studio",
    "docker:up": "docker compose -f docker/compose.yml up -d",
    "docker:down": "docker compose -f docker/compose.yml down",
    "docker:logs": "docker compose -f docker/compose.yml logs -f",
    "docker:rebuild": "docker compose -f docker/compose.yml up -d --build",
    "setup": "bun install && bun run db:generate && bun run db:push",
    "clean": "rm -rf node_modules bun.lock apps/web/.next packages/*/dist"
  },
  "dependencies": {
    "typescript": "latest",
    "@types/node": "latest",
    "bun-types": "latest"
  },
  "packageManager": "bun",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react-native": "^0.73.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.3.0",
    "expo": "^55.0.23",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.5"
  }
}
