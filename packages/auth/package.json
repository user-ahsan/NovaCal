{
  "name": "@novacal/auth",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    },
    "./client": {
      "import": "./dist/client.js",
      "types": "./dist/client.d.ts"
    },
    "./config": {
      "import": "./dist/config.js",
      "types": "./dist/config.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run tsc",
    "typecheck": "bun run tsc --noEmit"
  },
  "dependencies": {
    "better-auth": "latest",
    "@novacal/db": "workspace:*",
    "@novacal/shared": "workspace:*",
    "bcrypt": "latest",
    "ioredis": "latest",
    "drizzle-orm": "latest"
  },
  "devDependencies": {
    "@types/bcrypt": "latest",
    "@types/node": "latest",
    "typescript": "latest"
  }
}
