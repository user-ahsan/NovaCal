{
  "name": "@novacal/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./schema": {
      "import": "./dist/schema/index.js",
      "types": "./dist/schema/index.d.ts"
    }
  },
  "files": [
    "dist",
    "schema",
    "migrations",
    "drizzle.config.ts"
  ],
  "scripts": {
    "build": "bun run tsc",
    "generate": "bun run drizzle-kit generate",
    "migrate": "bun run drizzle-kit migrate",
    "push": "bun run drizzle-kit push",
    "studio": "bun run drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "latest",
    "postgres": "latest"
  },
  "devDependencies": {
    "drizzle-kit": "latest"
  }
}
